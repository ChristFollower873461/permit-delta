# Permit Delta - Environment Variable Template
# Copy this file to .env and fill in the values. Never commit .env to source control.

# FastAPI Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Google Vertex AI Configuration (Uses Application Default Credentials)
# Production/local live inference uses these variables and Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Parallel Search API Key
PARALLEL_API_KEY=

# Mode Toggle
# If set to True, calls to Parallel/Gemini will execute actual requests if keys and Vertex AI ADC are present,
# otherwise it will use safety-compliant fallback behavior.
LIVE_PARTNERS=False
